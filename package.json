{
  "name": "acme-compensation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "seed": "node server/seed.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check server/*.ts src tests docs README.md package.json tsconfig.json vite.config.ts index.html .github pnpm-workspace.yaml api vercel.json scripts *.config.ts eslint.config.mjs",
    "format": "prettier --write server/*.ts src tests docs README.md package.json tsconfig.json vite.config.ts index.html .github pnpm-workspace.yaml api vercel.json scripts *.config.ts eslint.config.mjs",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint server src tests scripts api *.ts *.mjs && node scripts/check-test-locations.mjs",
    "test:all": "pnpm test && pnpm test:web && pnpm test:e2e",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tursodatabase/serverless": "^1.4.1",
    "@vercel/functions": "^3.9.11",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.33.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.25.0"
}
