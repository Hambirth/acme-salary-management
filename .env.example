PORT=4000
DATABASE_PATH=./data/acme.sqlite
# Set NODE_ENV=production behind HTTPS for secure session cookies.
# Set DEMO_PASSWORD before seeding a publicly hosted environment.
DEMO_PASSWORD=AssessmentDemo42!

# For Vercel: use a durable hosted libSQL database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TRUST_PROXY=0

# Optional exact browser origin. Default: same origin as this request.
APP_ORIGIN=
# Structured console and async database logging thresholds
LOG_LEVEL=info
LOG_DB_MIN_LEVEL=warn
